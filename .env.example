# Copy this file to .env.local and fill in the values.
# Supabase dashboard → Project Settings → API Keys.

# Public values (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://mjkdyokcqbaowjynodhl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Absolute site URL for links in emails/SMS; optional in development.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.co.nz

# ---- Server-only secrets: never prefix with NEXT_PUBLIC_, never commit ----

# Supabase secret (service role) key — needed by the notification dispatcher.
# SUPABASE_SECRET_KEY=

# Notification dispatcher (docs/07)
# CRON_SECRET=a-long-random-string
# RESEND_API_KEY=
# EMAIL_FROM=Bookings <bookings@yourdomain.co.nz>
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Stripe (docs/06) — added in the payments phase
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
